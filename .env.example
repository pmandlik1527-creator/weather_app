# ====================================================================
# National Weather Big Data Analytics Platform (NWBDAP)
# Environment Configuration
# ====================================================================

# Supabase Cloud Database Configuration
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Server Port and Host
PORT=5005
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=imd-moes-national-weather-analytics-2026-secret

# OpenRouter AI Weather Forecast (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
